# ============================================================================
# FLACRON AUTO SOCIAL — CLOUD FUNCTIONS ENVIRONMENT VARIABLES
# Copy this file to `.env` for local emulator use, and set the same values
# as Firebase Functions secrets/config for deployed environments:
#
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:config:set app.env="production"
#
# NEVER commit a real .env file. NEVER expose any of these values to the
# Flutter frontend. All values below are consumed exclusively inside
# Cloud Functions (functions/src/**).
# ============================================================================

# ---- App ----
APP_ENV=development
APP_BASE_URL=https://app.flacronautosocial.com
FUNCTIONS_REGION=us-central1

# ---- Firebase ----
FIREBASE_PROJECT_ID=flacron-auto-social-dev
FIREBASE_STORAGE_BUCKET=flacron-auto-social-dev.appspot.com

# ---- Token Encryption ----
# 32-byte (256-bit) key, base64 encoded, used to encrypt OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=replace-with-generated-32-byte-base64-key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_STARTER=price_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me
STRIPE_PRICE_ID_AGENCY=price_replace_me
STRIPE_PORTAL_RETURN_URL=https://app.flacronautosocial.com/billing

# ---- AI Providers (choose one or more; app.ts routes by AI_PROVIDER) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_me
CLAUDE_API_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENAI_COMPATIBLE_BASE_URL=

# ---- Meta (Instagram Business + Facebook Pages) ----
META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_REDIRECT_URI=https://us-central1-flacron-auto-social-dev.cloudfunctions.net/oauthCallback?platform=meta

# ---- X / Twitter ----
TWITTER_CLIENT_ID=replace_me
TWITTER_CLIENT_SECRET=replace_me
TWITTER_REDIRECT_URI=https://us-central1-flacron-auto-social-dev.cloudfunctions.net/oauthCallback?platform=twitter

# ---- LinkedIn ----
LINKEDIN_CLIENT_ID=replace_me
LINKEDIN_CLIENT_SECRET=replace_me
LINKEDIN_REDIRECT_URI=https://us-central1-flacron-auto-social-dev.cloudfunctions.net/oauthCallback?platform=linkedin

# ---- Rate Limiting ----
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_SCHEDULING_PER_MINUTE=20

# ---- Email (weekly reports, notifications) ----
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=replace_me
EMAIL_FROM_ADDRESS=noreply@flacronautosocial.com
